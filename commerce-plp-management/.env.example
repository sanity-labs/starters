# Copy this file to .env and fill in your values.
#
# This root file is loaded by the blueprint deploy (sanity.blueprint.ts, via
# dotenv/config) and the push-sync Function tooling. It holds the Sanity project
# coordinates plus the Shopify Admin credentials the push-sync needs.
# Never commit .env (it is gitignored).

# --- Sanity ---------------------------------------------------------------
# From sanity.io/manage. `sanity init --template` fills these in for you.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Write token (Editor+). Used by the seed script and the push-sync Function to
# update syncStatus on documents. Create at sanity.io/manage -> API -> Tokens.
SANITY_API_WRITE_TOKEN=

# --- Shopify Admin API (push-sync: writes the sanity_plp_collection metaobject)
# Sensitive: server/Function only, never shipped to the browser.
# App needs scopes: write_metaobjects, write_metaobject_definitions, read_products.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Dev Dashboard app: Client ID + Secret are exchanged for a short-lived Admin
# token automatically (client credentials grant). Find them in the Dev Dashboard
# under your app -> Settings. See:
# https://shopify.dev/docs/apps/build/dev-dashboard/get-api-access-tokens
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Legacy alternative: store-level custom app static token (shpat_...). Use this
# INSTEAD of the client credentials above if your app provides a static token.
# SHOPIFY_ADMIN_API_TOKEN=

SHOPIFY_ADMIN_API_VERSION=2025-07
