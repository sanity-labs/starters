# Project vars — the Sanity CLI fills these in during `sanity init --template`.
#
# This starter keeps env per workspace; nothing cascades from this root file:
#   studio/.env     — SANITY_STUDIO_PROJECT_ID / SANITY_STUDIO_DATASET
#                     (Studio, CLI, typegen, sanity.blueprint.ts)
#   app/.env.local  — Next.js: project, read token, org token, MCP URLs,
#                     Anthropic key (`pnpm bootstrap` creates and fills it)
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=
