# Copy this file to .env.local. `pnpm bootstrap` fills project/dataset and the
# help-center read token. Paste Context app values after you create the MCPs.

# Sanity project ID + dataset
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Project Viewer token for rendering the help center against a private dataset.
# Server-side only. Created by bootstrap, or at:
# sanity.io/manage -> Your Project -> API -> Tokens
SANITY_API_READ_TOKEN=

# Organization ID (Manage -> your organization)
SANITY_ORGANIZATION_ID=

# Organization API token with Context Viewer. Server-side only.
# A project token is refused (403 contextGrantRequired).
# Create at: Manage -> API -> Tokens (organization level)
SANITY_ORGANIZATION_TOKEN=

# Context MCP endpoint URLs from the Context app.
# Shape: https://api.sanity.io/v1/context/organizations/<orgId>/mcp/<name>
SANITY_MCP_SUPPORT_GROQ_URL=
SANITY_MCP_SUPPORT_KB_URL=
SANITY_MCP_OPS_GROQ_URL=
SANITY_MCP_OPS_KB_URL=

# Anthropic API key — powers the chat model (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Required only for identity-linked org keys. Workspace-scoped keys skip this.
# Claude Console → Settings → Workspaces (wrkspc_…)
ANTHROPIC_WORKSPACE_ID=
