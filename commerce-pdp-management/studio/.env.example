# Copy this file to .env and fill in your values.
# Loaded by the Studio CLI (sanity.cli.ts -> process.loadEnvFile) and bootstrap.

# Your Sanity project ID (from sanity.io/manage)
SANITY_STUDIO_PROJECT_ID=your-project-id

# Dataset name (usually "production")
SANITY_STUDIO_DATASET=production

# Storefront URL for the Presentation tool live preview
SANITY_STUDIO_PREVIEW_URL=http://localhost:3000

# --- Shopify Storefront API (product picker reads the catalog by name) -------
# Public Storefront token is safe in Studio; it only reads the published catalog.
# Dev Dashboard apps don't show a static Storefront token — mint one with
# `pnpm shopify:storefront-token` (uses the Admin creds in the root .env).
# The Admin Client ID/Secret stay in the ROOT .env only, never here.
SANITY_STUDIO_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SANITY_STUDIO_SHOPIFY_STOREFRONT_TOKEN=
SANITY_STUDIO_SHOPIFY_STOREFRONT_API_VERSION=2025-07
