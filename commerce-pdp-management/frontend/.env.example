# Copy this file to .env and fill in your values.
# Loaded by Next.js.

# --- Sanity ---------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# API version for the Sanity client (YYYY-MM-DD)
NEXT_PUBLIC_SANITY_API_VERSION=2025-07-13

# Read token with Viewer permissions, for draft mode / visual editing.
# Create at sanity.io/manage -> API -> Tokens.
# SANITY_API_READ_TOKEN=

# Studio URL for the "Open in Studio" links / presentation origin.
# NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# Shared secret the cache-revalidate Function uses to trigger on-demand
# revalidation. Must match SANITY_REVALIDATE_SECRET in the root .env.
SANITY_REVALIDATE_SECRET=

# --- Shopify Storefront API (products, price, inventory) --------------------
# Public Storefront token. Safe to expose to the storefront runtime.
# Dev Dashboard apps don't show a static Storefront token — mint one with
# `pnpm shopify:storefront-token` (uses the Admin creds in the root .env).
# The Admin Client ID/Secret stay in the ROOT .env only, never here.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
NEXT_PUBLIC_SHOPIFY_STOREFRONT_API_VERSION=2025-07
