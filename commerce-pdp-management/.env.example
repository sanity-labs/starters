# Copy this file to .env and fill in your values. Never commit .env.
# Loaded by sanity.blueprint.ts (dotenv/config) and the Shopify setup scripts.
#
# This starter uses a three-env split:
#   .env (root)     — this file. Admin credentials + Function runtime config.
#   studio/.env     — public Storefront token for the product picker.
#   frontend/.env   — public Sanity + Shopify tokens for the storefront.
# Admin credentials live ONLY here and on the Function runtime, never in a browser.

# --- Sanity ---------------------------------------------------------------
SANITY_STUDIO_PROJECT_ID=your-project-id
SANITY_STUDIO_DATASET=production

# --- Storefront cache revalidation ----------------------------------------
# The cache-revalidate Function pings this URL on enrichment publish. Point it at
# your deployed storefront (e.g. https://your-app.vercel.app/api/revalidate) or
# a tunnel for local testing. The secret must match frontend/.env.
STOREFRONT_REVALIDATE_URL=http://localhost:3000/api/revalidate
SANITY_REVALIDATE_SECRET=

# --- Shopify Admin API (one-time: mint a public Storefront token) ----------
# PDP enrichment is pull-only — nothing is written to Shopify. These Admin creds
# are used ONLY by `pnpm shopify:storefront-token` to mint the public Storefront
# token you paste into studio/.env and frontend/.env.
# Dev Dashboard apps use Client ID + Secret (exchanged for a short-lived token);
# a legacy static SHOPIFY_ADMIN_API_TOKEN also works.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# SHOPIFY_ADMIN_API_TOKEN=
SHOPIFY_ADMIN_API_VERSION=2025-07
