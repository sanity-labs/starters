# Copy this file to studio/.env and fill in your values.
# Required for `pnpm bootstrap`, `sanity exec`, and `sanity dev`.
# Studio CLI loads THIS file (studio/.env) — not the root `.env.local`.

# Your Sanity project ID (from sanity.io/manage)
SANITY_STUDIO_PROJECT_ID=your-project-id

# Dataset name (usually "production")
SANITY_STUDIO_DATASET=production

# Where the frontend runs — used by the Presentation tool for Visual Editing
SANITY_STUDIO_PREVIEW_URL=http://localhost:3000
