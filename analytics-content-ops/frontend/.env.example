# Copy this file to frontend/.env and fill in your values.
# Use the same project ID / dataset as studio/.env and the root .env.

# Sanity project ID
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Sanity dataset name (usually "production")
NEXT_PUBLIC_SANITY_DATASET=production

# URL of the deployed Studio (used for Visual Editing stega links).
# Defaults to "/studio" when unset.
# NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# Sanity API token with Viewer permissions (read-only), for draft previews.
# Create at: sanity.io/manage -> Your Project -> API -> Tokens
# SANITY_API_READ_TOKEN=
