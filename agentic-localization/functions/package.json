{
  "name": "@starter/functions",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./handle-deleted-subject": {
      "source": "./handle-deleted-subject/index.ts",
      "default": "./handle-deleted-subject/index.ts"
    },
    "./start-localization": {
      "source": "./start-localization/index.ts",
      "default": "./start-localization/index.ts"
    }
  },
  "scripts": {
    "build": "rolldown -c rolldown.config.ts",
    "typecheck": "tsc --noEmit",
    "predev": "pnpm run build",
    "dev": "sanity functions dev",
    "predeploy": "pnpm run build",
    "deploy": "sanity blueprints deploy"
  },
  "devDependencies": {
    "@sanity/client": "catalog:",
    "@sanity/functions": "^1.2.0",
    "@sanity/id-utils": "^1.0.0",
    "@sanity/workflow-engine": "catalog:",
    "@starter/l10n": "workspace:*",
    "@starter/tsconfig": "workspace:*",
    "rolldown": "catalog:"
  },
  "//exports": [
    "Source entries, for `e2e/` only: the end-to-end suite drives the real handlers with synthesized event envelopes instead of reimplementing them. The deployed artifact is still `dist/`, built by rolldown from the same files."
  ]
}
