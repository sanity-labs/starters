{
  "name": "@starter/l10n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./prompts": {
      "source": "./src/prompts/index.ts",
      "default": "./src/prompts/index.ts"
    },
    "./workflows": {
      "source": "./src/workflows/index.ts",
      "default": "./src/workflows/index.ts"
    },
    "./effects": {
      "source": "./src/effects/index.ts",
      "default": "./src/effects/index.ts"
    },
    "./distill": {
      "source": "./src/distill/index.ts",
      "default": "./src/distill/index.ts"
    },
    "./credentials": {
      "source": "./src/credentials/index.ts",
      "default": "./src/credentials/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "eval": "vitest run --config vitest.eval.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@portabletext/markdown": "^1.1.3",
    "@portabletext/toolkit": "^5.0.1",
    "@portabletext/types": "^4.0.1",
    "@sanity/asset-utils": "^2.3.0",
    "@sanity/diff": "^6.6.0",
    "@sanity/id-utils": "^1.0.0",
    "@sanity/util": "^6.6.0",
    "@sanity/workflow-engine": "catalog:"
  },
  "devDependencies": {
    "@sanity/client": "catalog:",
    "@sanity/codegen": "^5.10.1",
    "@sanity/types": "^6.6.0",
    "@sanity/workflow-engine-test": "catalog:",
    "@starter/sanity-types": "workspace:*",
    "@starter/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "configstore": "^8.0.0",
    "groq": "catalog:",
    "rolldown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@sanity/client": "^7.0.0",
    "@sanity/types": "^6.0.0",
    "groq": "^6.0.0"
  },
  "//devDependencies": [
    "rolldown is the bundler `src/exports.test.ts` drives to assert the entry graphs stay React-free; it is pinned via the catalog alongside @starter/functions."
  ]
}
