{
  "name": "agentic-localization",
  "version": "2.0.0",
  "private": true,
  "description": "Store translation glossaries, style guides, and locale rules as structured content in Sanity. Assemble them into prompts that guide AI translation agents on terminology, tone, and brand voice.",
  "keywords": [
    "agent-actions",
    "agentic",
    "ai",
    "app-sdk",
    "automation",
    "dashboard",
    "glossary",
    "groq",
    "i18n",
    "l10n",
    "localization",
    "prompt-assembly",
    "sanity",
    "studio",
    "style-guide",
    "translation"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "SANITY_STUDIO_SERVER_OPEN=true concurrently -n studio,dashboard,functions,frontend -c \"#f03e2f,#43b1b0,#f5a623,#8b5cf6\" \"pnpm --filter studio dev\" \"pnpm --filter @starter/translations-dashboard dev\" \"pnpm --filter @starter/functions dev\" \"pnpm --filter @starter/frontend dev\"",
    "build": "pnpm -r build",
    "deploy": "pnpm -r deploy",
    "bootstrap": "pnpm --filter studio bootstrap",
    "test": "pnpm -r test",
    "eval": "pnpm --filter @starter/l10n eval",
    "e2e": "pnpm --filter @starter/e2e e2e",
    "e2e:browser": "pnpm --filter @starter/e2e e2e:browser",
    "lint": "pnpm run oxlint",
    "lint:fix": "pnpm run lint --fix --fix-suggestions",
    "oxlint": "oxlint --disable-nested-config",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typegen": "pnpm --filter studio typegen && pnpm --filter @starter/frontend typegen",
    "pretypecheck": "pnpm run typegen",
    "typecheck": "pnpm -r typecheck",
    "validate": "sanity-template-validate",
    "workflows:deploy": "sanity-workflows deploy"
  },
  "devDependencies": {
    "@sanity/blueprints": "0.12.2",
    "@sanity/client": "catalog:",
    "@sanity/plugin-kit": "10.0.0",
    "@sanity/template-validator": "^3.0.0",
    "@sanity/workflow-cli": "catalog:",
    "@sanity/workflow-engine": "catalog:",
    "@starter/l10n": "workspace:*",
    "@types/node": "^22.19.13",
    "concurrently": "^9.2.1",
    "groq": "catalog:",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "sanity": "catalog:",
    "tsx": "^4.21.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.30.3"
}
