# Copy to `e2e/.env` (gitignored). SANITY_STUDIO_PROJECT_ID comes from the
# starter root .env; the suite never reads SANITY_STUDIO_DATASET, because it owns
# its own dataset pair below.

# A token with write access to the two e2e datasets — and dataset-create rights
# if they do not exist yet. Omit to fall back on a local `sanity login` session.
SANITY_AUTH_TOKEN=

# Override only to point the suite at datasets you already have.
# SANITY_E2E_CONTENT_DATASET=e2e
# SANITY_E2E_WORKFLOWS_DATASET=workflows-e2e
