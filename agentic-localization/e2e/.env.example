# Copy to `e2e/.env` (gitignored). SANITY_STUDIO_PROJECT_ID comes from the
# starter root .env; the API journeys never read SANITY_STUDIO_DATASET, because
# they own their own dataset pair below. The browser journeys do read it: they
# drive the dev servers, which serve that dataset.

# A token with write access to the two e2e datasets — and dataset-create rights
# if they do not exist yet. Omit to fall back on a local `sanity login` session.
SANITY_AUTH_TOKEN=

# Override only to point the suite at datasets you already have.
# SANITY_E2E_CONTENT_DATASET=e2e
# SANITY_E2E_WORKFLOWS_DATASET=workflows-e2e

# Where the browser journeys look for the dev servers, and where their
# screenshots land.
# SANITY_E2E_STUDIO_URL=http://localhost:3333
# SANITY_E2E_DASHBOARD_URL=http://localhost:3334
# L10N_SHOTS_DIR=/tmp/l10n-shots/e2e-browser
