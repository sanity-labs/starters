# Project vars — the Sanity CLI fills these in during `sanity init --template`.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=

# Required for `sanity app deploy`
# SANITY_STUDIO_ORGANIZATION_ID=

# Production Studio URL for dashboard "Open in Studio" links and for the
# visual-editing overlays the frontend encodes into draft content
# SANITY_STUDIO_URL=

# Origin the Presentation tool previews. Defaults to http://localhost:3000
# SANITY_STUDIO_PREVIEW_ORIGIN=
