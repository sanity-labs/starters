# Filled in by `sanity init --template`. Mapped from SANITY_STUDIO_* at dev time via next.config.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_API_READ_TOKEN=

# Absolute base for canonical URLs, hreflang alternates and the sitemap.
# Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
